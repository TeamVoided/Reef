{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${authors}" ],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "org.teamvoided.reef.Reef::commonInit"
      }
    ]
  },
  "mixins": [ "reef.mixins.json" ],
  "depends": {
    "java": ">=${java}",
    "minecraft": ">=${min_minecraft} <${max_minecraft}",
    "fabricloader": "*",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin}"
  },
  "contact": {
    "homepage": "https://github.com/${github_repo}",
    "issues": "https://github.com/${github_repo}/issues",
    "sources": "https://github.com/${github_repo}",
    "discord": "${discord_invite}"
  },
  "license": "${license}",
  "icon": "assets/reef/icon.png",
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}